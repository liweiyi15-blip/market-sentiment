{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -u main.py",
    "cronSchedule": "*/5 13-22 * * 1-5",
    "restartPolicyType": "NEVER",
    "numReplicas": 1,
    "overlapSeconds": 0
  }
}
